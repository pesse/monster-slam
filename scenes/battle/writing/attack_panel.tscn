[gd_scene format=3]

[node name="AttackPanel" type="HBoxContainer"]
theme_type_variation = &"ScreenStack"
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BossSpace" type="Control" parent="."]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Card" type="PanelContainer" parent="."]
theme_type_variation = &"HudPanel"
custom_minimum_size = Vector2(420, 0)
layout_mode = 2

[node name="CardStack" type="VBoxContainer" parent="Card"]
theme_type_variation = &"ScreenStack"
layout_mode = 2

[node name="BossLine" type="Label" parent="Card/CardStack"]
unique_name_in_owner = true
theme_type_variation = &"Accent"
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
autowrap_mode = 3
text = "…"

[node name="Charge" type="ProgressBar" parent="Card/CardStack"]
unique_name_in_owner = true
theme_type_variation = &"BossHp"
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
max_value = 1.0
step = 0.01
show_percentage = false

[node name="Criteria" type="VBoxContainer" parent="Card/CardStack"]
unique_name_in_owner = true
theme_type_variation = &"Tight"
layout_mode = 2

[node name="Note" type="Label" parent="Card/CardStack"]
unique_name_in_owner = true
theme_type_variation = &"Hint"
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Space" type="Control" parent="Card/CardStack"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="ContinueButton" type="Button" parent="Card/CardStack"]
unique_name_in_owner = true
theme_type_variation = &"ActionButton"
layout_mode = 2
disabled = true
text = "…"
