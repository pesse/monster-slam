anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Root" type="VBoxContainer" parent="UI/Margin"]
theme_type_variation = &"ScreenStack"
mouse_filter = 2

[node name="Menu" type="PanelContainer" parent="UI/Margin/Root"]
