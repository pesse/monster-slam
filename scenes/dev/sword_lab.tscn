text = "Schwert-Werkbank"

[node name="Hint" type="Label" parent="UI/Margin/Root/Menu/Items"]
theme_type_variation = &"Hint"
custom_minimum_size = Vector2(420, 0)
autowrap_mode = 3
text = "Das Skelett aus dem Hauptmenü. Oberarm und Handgelenk wirken nur beim Gehen (WALK_ARM), der Griff immer (SWORD_TURN). Winkel in Grad, je im Raum des Knochens."

