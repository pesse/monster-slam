theme_override_constants/separation = 6

[node name="WantedSection" type="VBoxContainer" parent="Margin/Root/Tabs/Überblick/Overview"]
theme_override_constants/separation = 4

[node name="WantedTitle" type="Label" parent="Margin/Root/Tabs/Überblick/Overview/WantedSection"]
