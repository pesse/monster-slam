[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/stats_screen.gd" id="1_stats"]

[node name="StatsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_stats")

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Root" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Root"]

[node name="BackButton" type="Button" parent="Margin/Root/Header"]
unique_name_in_owner = true
text = "← Zurück"

[node name="Title" type="Label" parent="Margin/Root/Header"]
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 28
text = "Statistik"
horizontal_alignment = 1

[node name="Tabs" type="TabContainer" parent="Margin/Root"]
size_flags_vertical = 3

[node name="Überblick" type="ScrollContainer" parent="Margin/Root/Tabs"]

[node name="Overview" type="VBoxContainer" parent="Margin/Root/Tabs/Überblick"]
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="StatLines" type="VBoxContainer" parent="Margin/Root/Tabs/Überblick/Overview"]
