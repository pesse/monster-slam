[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/settings_menu.gd" id="1_settings"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Root" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Root"]

[node name="BackButton" type="Button" parent="Margin/Root/Header"]
unique_name_in_owner = true
text = "← Zurück"

[node name="Title" type="Label" parent="Margin/Root/Header"]
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 28
text = "Einstellungen & Statistik"
horizontal_alignment = 1

[node name="Tabs" type="TabContainer" parent="Margin/Root"]
size_flags_vertical = 3

[node name="Profil" type="VBoxContainer" parent="Margin/Root/Tabs"]
theme_override_constants/separation = 10

[node name="PickLabel" type="Label" parent="Margin/Root/Tabs/Profil"]
text = "Aktives Profil"

[node name="ProfileSelect" type="OptionButton" parent="Margin/Root/Tabs/Profil"]
unique_name_in_owner = true

[node name="RenameRow" type="HBoxContainer" parent="Margin/Root/Tabs/Profil"]

[node name="RenameInput" type="LineEdit" parent="Margin/Root/Tabs/Profil/RenameRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Profilname"

[node name="RenameButton" type="Button" parent="Margin/Root/Tabs/Profil/RenameRow"]
unique_name_in_owner = true
text = "Umbenennen"

[node name="DiffLabel" type="Label" parent="Margin/Root/Tabs/Profil"]
text = "Standard-Schwierigkeit"

[node name="DiffRow" type="HBoxContainer" parent="Margin/Root/Tabs/Profil"]
unique_name_in_owner = true

[node name="Diff1" type="Button" parent="Margin/Root/Tabs/Profil/DiffRow"]
text = "1"

[node name="Diff2" type="Button" parent="Margin/Root/Tabs/Profil/DiffRow"]
text = "2"

[node name="Diff3" type="Button" parent="Margin/Root/Tabs/Profil/DiffRow"]
text = "3"

[node name="Diff4" type="Button" parent="Margin/Root/Tabs/Profil/DiffRow"]
text = "4"

[node name="Diff5" type="Button" parent="Margin/Root/Tabs/Profil/DiffRow"]
text = "5"

[node name="SpeedLabel" type="Label" parent="Margin/Root/Tabs/Profil"]
unique_name_in_owner = true
text = "Grund-Geschwindigkeit: 100 %"

[node name="SpeedSlider" type="HSlider" parent="Margin/Root/Tabs/Profil"]
unique_name_in_owner = true
min_value = 0.5
max_value = 1.5
step = 0.05
value = 1.0

[node name="ResetButton" type="Button" parent="Margin/Root/Tabs/Profil"]
unique_name_in_owner = true
text = "Fortschritt zurücksetzen"

[node name="Statistik" type="VBoxContainer" parent="Margin/Root/Tabs"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Wörter" type="ScrollContainer" parent="Margin/Root/Tabs"]

[node name="WordList" type="VBoxContainer" parent="Margin/Root/Tabs/Wörter"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Melden" type="VBoxContainer" parent="Margin/Root/Tabs"]
theme_override_constants/separation = 8

[node name="TokenLabel" type="Label" parent="Margin/Root/Tabs/Melden"]
theme_override_font_sizes/font_size = 18
text = "Melde-Token"

[node name="TokenHint" type="Label" parent="Margin/Root/Tabs/Melden"]
autowrap_mode = 3
text = "Mit einem Melde-Token kannst du falsche oder unklare Vokabeln melden. Übertragen werden dann: das gemeldete Wort, dein Kommentar, die Spielversion und der Name, der im Token steht — kein Profilname und keine Fortschrittsdaten."

[node name="TokenRow" type="HBoxContainer" parent="Margin/Root/Tabs/Melden"]

[node name="TokenInput" type="LineEdit" parent="Margin/Root/Tabs/Melden/TokenRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "name.XXXX-XXXX-XXXX-XXXX"

[node name="TokenButton" type="Button" parent="Margin/Root/Tabs/Melden/TokenRow"]
unique_name_in_owner = true
text = "Eintragen"

[node name="TokenForget" type="Button" parent="Margin/Root/Tabs/Melden/TokenRow"]
unique_name_in_owner = true
text = "Vergessen"

[node name="TokenStatus" type="Label" parent="Margin/Root/Tabs/Melden"]
unique_name_in_owner = true
autowrap_mode = 3

[node name="FlagScroll" type="ScrollContainer" parent="Margin/Root/Tabs/Melden"]
unique_name_in_owner = true
size_flags_vertical = 3

[node name="FlagList" type="VBoxContainer" parent="Margin/Root/Tabs/Melden/FlagScroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="ResetDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
dialog_text = "Fortschritt dieses Profils wirklich löschen?"
