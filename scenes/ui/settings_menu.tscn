[node name="GraphicsNote" type="Label" parent="Window/Layout/Content/Body/Pages/ProfilePage/Gutter/Profile"]
layout_mode = 2
theme_type_variation = &"Caption"
text = "„Mittel“ lässt das Leuchten weg und glättet Kanten weniger. „Schnell“ lässt dazu Kantenglättung, Wolkenschatten, Bodenflecken und fliegende Blätter oder Flocken weg — für ältere Rechner, wenn das Spiel ruckelt. Gilt für diesen Rechner, nicht nur für dieses Profil."
autowrap_mode = 3

