[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/book_select.gd" id="1_screen"]

[node name="BookSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")

[node name="Margin" type="MarginContainer" parent="."]
theme_type_variation = &"ScreenMargin"
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Root" type="VBoxContainer" parent="Margin"]
theme_type_variation = &"ScreenStack"

[node name="Header" type="HBoxContainer" parent="Margin/Root"]

[node name="BackButton" type="Button" parent="Margin/Root/Header"]
unique_name_in_owner = true
text = "← Zurück"

[node name="Title" type="Label" parent="Margin/Root/Header"]
theme_type_variation = &"Title"
size_flags_horizontal = 3
text = "Welches Buch?"
horizontal_alignment = 1

[node name="EmptyHint" type="Label" parent="Margin/Root"]
unique_name_in_owner = true
visible = false
theme_type_variation = &"Hint"
text = "Noch kein Buch vorhanden — im Start-Screen unter „📚 Inhalte“ einen Vokabel-Pack installieren."
