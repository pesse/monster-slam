autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/Root"]
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Gutter" type="MarginContainer" parent="Margin/Root/Scroll"]
theme_type_variation = &"ScrollGutter"
size_flags_horizontal = 3

[node name="Books" type="VBoxContainer" parent="Margin/Root/Scroll/Gutter"]
unique_name_in_owner = true
theme_type_variation = &"SectionStack"
size_flags_horizontal = 3
