[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/content_pack_row.gd" id="1_row"]

[node name="ContentPackRow" type="PanelContainer"]
script = ExtResource("1_row")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Root" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 4

[node name="Head" type="HBoxContainer" parent="Margin/Root"]
theme_override_constants/separation = 10

[node name="Select" type="CheckBox" parent="Margin/Root/Head"]
unique_name_in_owner = true

[node name="Name" type="Label" parent="Margin/Root/Head"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Pack"

[node name="State" type="Label" parent="Margin/Root/Head"]
unique_name_in_owner = true
text = "Zustand"

[node name="Info" type="Label" parent="Margin/Root"]
unique_name_in_owner = true
autowrap_mode = 3
theme_override_font_sizes/font_size = 12

[node name="CodeRow" type="HBoxContainer" parent="Margin/Root"]
unique_name_in_owner = true
visible = false
theme_override_constants/separation = 8

[node name="CodeInput" type="LineEdit" parent="Margin/Root/CodeRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Zugangscode"

[node name="RedeemButton" type="Button" parent="Margin/Root/CodeRow"]
unique_name_in_owner = true
text = "Einlösen"

[node name="ForgetButton" type="Button" parent="Margin/Root/CodeRow"]
unique_name_in_owner = true
visible = false
text = "Code verwerfen"
