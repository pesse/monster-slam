[gd_resource type="Theme" load_steps=10 format=3]

; Gemeinsames UI-Theme im KayKit-Look (Low-Poly-Mittelalter): dunkle Schiefer-/Burgblau-
; Panels mit hellem Stein-Rand, warm-oranger Kampf-Akzent (Fokus/ProgressBar-Füllung),
; heller Text. Wird projektweit gesetzt (project.godot -> gui/theme/custom), damit HUD,
; Statistik-Screen, Eingabefeld und Debug-Panel einheitlich wirken.

