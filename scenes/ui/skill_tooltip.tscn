[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/skill_tooltip.gd" id="1_tooltip"]

[node name="SkillTooltip" type="PanelContainer"]
script = ExtResource("1_tooltip")

[node name="Root" type="VBoxContainer" parent="."]
theme_type_variation = &"Tight"

[node name="Name" type="Label" parent="Root"]
theme_type_variation = &"SectionTitle"
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
text = "Name"
autowrap_mode = 3

[node name="Description" type="Label" parent="Root"]
theme_type_variation = &"Hint"
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
text = "Wirkung"
autowrap_mode = 3

[node name="Status" type="Label" parent="Root"]
theme_type_variation = &"Accent"
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
text = "Zustand"
autowrap_mode = 3
